<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+：厂商设备可能忽略 allowBackup=false 对设备间迁移的限制。 -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
